# Backend
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
# Local Docker/Homebrew example. In production, use the connection URL from a
# managed PostgreSQL provider or a private PostgreSQL service.
DATABASE_URL=postgresql://ai_workflow:ai_workflow_dev@localhost:5432/ai_workflow
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=ai-workflow-platform

# Frontend; leave empty in local development to use the Vite proxy.
VITE_API_BASE_URL=
