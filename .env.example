# ===== Backend HTTP =====
PORT=3000
HOST=0.0.0.0

# 访问控制：设置后所有 API 请求需携带 X-Invite-Code 头（或 invite_code 查询参数），留空则不启用
INVITE_CODE=

# Frontend; leave empty in local development to use the Vite proxy.
VITE_API_BASE_URL=

# HTTP long-running requests and SSE
HTTP_REQUEST_TIMEOUT_MS=900000
HTTP_KEEP_ALIVE_TIMEOUT_MS=75000
HTTP_CONNECTION_TIMEOUT_MS=0
SSE_HEARTBEAT_MS=15000

# ===== Model Provider =====
# mock（默认，测试用） | deepseek | openai | openai-compatible
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# OpenAI-compatible 通用配置（MODEL_PROVIDER 为 openai/openai-compatible 时使用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_PROVIDER_ID=deepseek
# Coding Agent（opencode）使用的模型名，需要带 provider 前缀，与 OPENAI_MODEL 命名体系不同
CODING_AGENT_MODEL=deepseek/deepseek-v4-flash
# 自举开发中分析/测试/审查 Agent 的最大工具调用轮数（运行完整测试套件需要较多轮数）
SELF_DEVELOPMENT_MAX_TOOL_ROUNDS=48
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_TIMEOUT_MS=60000

# ===== PostgreSQL（可选，未配置时降级为内存模式）=====
DATABASE_URL=postgresql://ai_workflow:ai_workflow_dev@localhost:5432/ai_workflow
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_KEEP_ALIVE_DELAY_MS=10000
DATABASE_MAX_LIFETIME_SECONDS=300
DATABASE_APPLICATION_NAME=ai-workflow-platform

# ===== Queue / Worker =====
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
WORKFLOW_TIMEOUT_MS=900000

# ===== Workspace =====
# Agent 工具（file_read / shell / git 等）的根目录边界，也是"工作环境"页展示的范围。
# 相对路径会按进程 cwd 解析（从 后端/ 目录启动时 data 即 后端/data）。
# 不要指向源码目录，Demo 的输入输出文件都放在这里。
WORKSPACE_ROOT=data

# ===== Self-Development（自举开发）=====
SELF_DEVELOPMENT_ENABLED=false
# 自举开发 workspace（git worktree）根目录
SELF_DEVELOPMENT_WORKSPACES_ROOT=../.ai-workflow-workspaces
# true：Coding Agent 在 Docker Sandbox 内运行（生产/Docker Compose 部署）
# false：直接调用宿主机 opencode CLI（本地开发）
CODING_AGENT_IN_SANDBOX=false

# ===== Docker Sandbox =====
SANDBOX_IMAGE=ai-workflow-sandbox:latest
SANDBOX_TIMEOUT_MS=600000
SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=2048
SANDBOX_PIDS_LIMIT=512
SANDBOX_ALLOW_NETWORK=false
# Coding Agent 输出 JSON 事件流（含文件内容）较大，1MB 在生产实测不够
SANDBOX_MAX_OUTPUT_BYTES=8388608
# 容器内 workspace 挂载路径（Docker Compose 中为 /workspace）
SANDBOX_CONTAINER_WORKSPACE_ROOT=/workspace
# 宿主机上 workspace 的绝对路径（用于 volume 挂载）
SANDBOX_HOST_WORKSPACE_ROOT=
